# Member repos cloned by bootstrap.sh — each is its own git repo, not tracked here.
/app/
/shared/
/hub/
/server/
/plugins/

# generated per-machine by bootstrap.sh (lists only the repos you cloned)
/myra.code-workspace

# compiled Bubble Tea progress UI (tui/ source IS tracked; the binary is not)
/tui/.bin/

# self-hosted GitHub Actions runner provisioned by runner.sh (downloaded + per-machine)
/.actions-runner/

# junk
.DS_Store
*.bun-build
.playwright-cli

# greppable code indexes generated by index.sh (per-machine, refreshed by hook)
/.claude/index/
